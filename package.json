{
  "name": "@lwplugins/data-table",
  "version": "0.2.0",
  "description": "Lightweight data table for WordPress admin React screens: search, filter chips, sorting and paging on core @wordpress/components. ~3 KB gzipped — a small alternative to DataViews.",
  "license": "GPL-2.0-or-later",
  "author": "LW Plugins (https://lwplugins.com)",
  "homepage": "https://github.com/lwplugins/data-table#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lwplugins/data-table.git"
  },
  "bugs": "https://github.com/lwplugins/data-table/issues",
  "keywords": [
    "wordpress",
    "gutenberg",
    "react",
    "table",
    "datatable",
    "dataviews",
    "wp-admin"
  ],
  "type": "module",
  "main": "build-module/index.js",
  "module": "build-module/index.js",
  "exports": {
    ".": "./build-module/index.js",
    "./style.css": "./src/data-table.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "build-module",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "babel src --out-dir build-module --ignore 'src/**/*.test.js'",
    "prepublishOnly": "npm test && npm run build",
    "test": "wp-scripts test-unit-js",
    "lint": "wp-scripts lint-js src test"
  },
  "peerDependencies": {
    "@wordpress/components": ">=28",
    "@wordpress/element": ">=6",
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@wordpress/babel-preset-default": "^8.56.0",
    "@wordpress/components": "^41.0.0",
    "@wordpress/element": "^8.8.0",
    "@wordpress/scripts": "^36.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
